# Copy this file to .env.local for local work. On Vercel, add the same names under
# Project Settings -> Environment Variables. Everything here is optional.

# Your public site URL, no trailing slash. Change this once you buy a custom domain.
# If empty, Vercel's production URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Public contact email shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=aqibawan0102@gmail.com

# Search engine ownership verification (paste only the code, not the whole tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google AdSense (leave empty until your AdSense account is approved)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Google Analytics 4 measurement ID, like G-XXXXXXXXXX (loaded only after consent)
NEXT_PUBLIC_GA_ID=

# Set to "true" to enable Vercel Web Analytics (also enable it in the Vercel dashboard)
NEXT_PUBLIC_VERCEL_ANALYTICS=
